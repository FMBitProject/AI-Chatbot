# Existing application credentials and integrations: see .env.local.example.
# Demo reuses DATABASE_URL, GROQ_API_KEY and GOOGLE_GENERATIVE_AI_API_KEY.
# Fixed demo workspace is defined in src/lib/demo/corpus.ts, never configurable
# by visitors or by an environment variable pointing at a customer tenant.
DEMO_CHAT_ENABLED=true
# Global generation attempts per rolling 24 hours; integer 1–10000.
# Every attempt reserves budget before embedding; errors still consume budget.
DEMO_DAILY_LIMIT=200
