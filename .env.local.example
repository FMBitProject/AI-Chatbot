# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:9002
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Groq API Key (chat) - console.groq.com
GROQ_API_KEY=

# Google AI API Key (embedding) - aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend (email notifikasi) - resend.com -> free 3000 email/bulan
RESEND_API_KEY=
EMAIL_DOMAIN=yourdomain.com

# Slack Integration - api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Midtrans Payment - dashboard.midtrans.com
# MIDTRANS_ENV: "sandbox" untuk testing, "production" untuk live
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_ENV=sandbox

# Support Email (tampil di pesan error quota, dll)
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Alert Email (internal, bukan untuk pelanggan)
# Tujuan notifikasi masalah pembayaran yang butuh penanganan manusia: refund/
# chargeback pada order yang sudah lunas, nominal yang tidak cocok dengan yang
# kita tagih, dan notifikasi yang mengaku sukses tapi tidak dikonfirmasi
# Midtrans. Kosongkan untuk log-only (default di lokal & preview).
ALERT_EMAIL=

# Google Analytics 4 - analytics.google.com -> Admin -> Data Streams
# Measurement ID berformat G-XXXXXXXXXX. Kosongkan untuk menonaktifkan GA.
# Analytics hanya jalan setelah pengunjung menerima cookie consent.
NEXT_PUBLIC_GA_ID=

# --- Otomasi konten media sosial (scripts/content/) ------------------------
# Hanya dipakai oleh script di lokal, TIDAK dibutuhkan aplikasi web.
# Tidak perlu diisi di Vercel.

# Model penulis konten. Default: Gemini free tier, pakai
# GOOGLE_GENERATIVE_AI_API_KEY yang sudah ada di atas — gratis, dan aman karena
# script ini hanya memproses materi marketing kita sendiri, bukan dokumen
# pelanggan. Isi "anthropic" (dan ANTHROPIC_API_KEY di bawah) kalau hasil
# tulisannya kurang bagus. Kosongkan = google.
CONTENT_PROVIDER=

# Opsional: paksa model tertentu. Kosong = default provider-nya.
# `npm run content:models` menampilkan model Gemini yang valid untuk key Anda.
CONTENT_MODEL=

# Anthropic (Claude) - console.anthropic.com/settings/keys
# HANYA perlu kalau CONTENT_PROVIDER=anthropic. Butuh saldo (min $5); credit ini
# dipakai bersama Claude Code, jadi pertimbangkan Workspace terpisah + spend limit.
ANTHROPIC_API_KEY=

# Buffer - publish.buffer.com/settings/api (harus owner organisasi)
# Paket gratis Buffer memberi 1 API key dan tidak butuh billing. Dipakai
# `npm run content:push` untuk mengirim post ke Buffer sebagai DRAFT.
BUFFER_API_KEY=

# ID channel di Buffer. Jalankan `npm run content:channels` untuk melihat
# daftarnya. Yang tidak diisi otomatis dilewati saat push.
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=

# Domain tempat kartu gambar Instagram dilayani. Buffer tidak punya endpoint
# upload — ia mengambil gambar dari URL publik SAAT POST TERBIT, jadi kartunya
# ditulis ke public/social/ dan dilayani situs kita sendiri setelah di-deploy.
# Kosong = https://www.intellibaseai.com (pakai www; apex redirect 308 ke sana).
SOCIAL_ASSET_BASE_URL=

# Maintenance Mode (kill-switch)
# Set MAINTENANCE_MODE=true lalu redeploy untuk menampilkan halaman "Sedang
# Dalam Perbaikan" ke semua pengunjung. Kosong/false = aplikasi normal.
MAINTENANCE_MODE=false
# Opsional: rahasia acak untuk bypass. Saat maintenance aktif, buka
# https://domain/?mnt-bypass=<secret> untuk tetap melihat situs asli
# (mis. verifikasi perbaikan) sementara pengunjung lain lihat halaman perbaikan.
MAINTENANCE_BYPASS_SECRET=

# Rekonsiliasi pembayaran (cron)
# Jadwalnya ada di vercel.json. Default "0 2 * * *" (sekali sehari, 09:00 WIB)
# karena paket Vercel Hobby hanya mengizinkan cron sekali sehari. Di paket Pro,
# ganti jadi "*/15 * * * *" supaya pembayaran yang webhook-nya hilang ketahuan
# dalam hitungan menit, bukan besok paginya.
# Rahasia acak yang melindungi /api/cron/reconcile-payments. Vercel Cron
# otomatis mengirimkannya sebagai header "Authorization: Bearer <secret>"
# begitu variabel ini di-set di Vercel. Tanpa ini, route-nya menolak SEMUA
# pemanggil (401) — jadi sweep-nya mati sampai variabelnya diisi.
# Buat dengan: openssl rand -hex 32
CRON_SECRET=
